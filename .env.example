VITE_API_ORIGIN=
API_HOST=127.0.0.1
API_PORT=8787
# Exact static browser origins. Development SSH previews additionally accept only
# http://new-lovable.localhost:<numeric-port>; production never enables that rule.
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEV_DYNAMIC_FORWARD_ORIGIN=false
DEV_FORWARD_HOST=new-lovable.localhost
DEV_FORWARD_PORT=
DATABASE_PATH=./data/omp-builder.db
PROJECTS_ROOT=./data/projects
OMP_SESSION_ROOT=./data/omp-sessions
OMP_CONFIG_DIR=./data/omp-config
OMP_MAX_PROCESSES=2
OMP_IDLE_MS=900000
SESSION_TTL_DAYS=14
SESSION_COOKIE_NAME=omp_builder_session
SESSION_COOKIE_SECURE=false
# Generate with: openssl rand -base64 32
SESSION_SECRET=replace-with-a-random-32-byte-secret
# Generate with: openssl rand -base64 32
OMP_MASTER_KEY=replace-with-a-random-32-byte-secret
OMP_BIN=omp
OMP_MODE=rpc
